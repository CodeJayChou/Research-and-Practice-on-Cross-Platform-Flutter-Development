{
  "name": "cross-platform-video-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the cross-platform Flutter video experience.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "fastify": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
